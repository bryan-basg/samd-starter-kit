{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Orquestador SaMD",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .claude/scripts/candado_suite_completa.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .claude/scripts/audit_clinical_log.py || true",
            "timeout": 10,
            "statusMessage": "Bitácora SaMD de módulos clínicos"
          }
        ]
      }
    ]
  }
}
