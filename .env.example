# .env.example — {{PROJECT_NAME}}
# REGLA: toda var nueva leída en código (config/Settings u os.getenv) DEBE estar acá,
# con un comentario SaMD-aware. El onboarding de devs no se rompe en silencio.
# FORMATO: el comentario va en su PROPIA línea, nunca detrás del `=`: hay lectores de .env
# (medido: python-dotenv < 1.2.4) que lo toman como VALOR.
# Las variables comentadas usan el default del código; descomentá las que completes.
# En PRODUCCIÓN, los secretos viven en el gestor de secretos, NO en este archivo.

# --- Identidad / Auth ---
# Proveedor de identidad (emite el token con el claim user_id).
# AUTH_PROVIDER=
# Vida del token de sesión. Sin exp, un token robado no caduca.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Cifrado (claves SEPARADAS, nunca reusar una para la otra) ---
# Sin descomentar, valen los defaults PÚBLICOS de dev: sirven para los tests, y la app se
# niega a arrancar con ellos fuera de TESTING.
# AES-256-GCM para PII/PHI en reposo. Generala con: openssl rand -base64 32
# ENCRYPTION_KEY=
# Firma de sesión, distinta de la anterior. Generala con: openssl rand -hex 32
# SECRET_KEY=

# --- Base de datos ---
# Cadena de conexión. Dev local puede usar SQLite.
# DATABASE_URL=

# --- Plataforma cloud ---
# (env vars de prod viven en el gestor de secretos; documentá acá cuáles existen)

# --- Flags ---
TESTING=False
# En prod, el scheduling lo hace un cron gestionado externo.
ENABLE_INTERNAL_SCHEDULER=false
