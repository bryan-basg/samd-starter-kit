{
  "components": {
    "schemas": {
      "ErrorOut": {
        "description": "Forma ÚNICA de todo error que sale de la API.\n\nEl default del framework para un 422 es `detail: [ {loc, msg, type}, … ]` —\nuna lista de errores de validación con rutas de campo y nombres de tipo, o\nsea jerga técnica que §5.4 prohíbe mostrarle a un usuario. Los handlers de\n`app/main.py` devuelven en su lugar UNA frase empática, así que el contrato\ntiene que declarar esa forma: si el contrato promete una lista y la app manda\ntexto, el cliente generado rompe.\n\nLo cazó el fuzz de contrato al validar la respuesta contra su propio esquema.",
        "properties": {
          "detail": {
            "examples": [
              "No pudimos leer los datos que enviaste."
            ],
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "NoteIn": {
        "properties": {
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "NoteIn",
        "type": "object"
      },
      "NoteOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "title": "NoteOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "summary": "Slice mínimo que demuestra identidad-por-token, cifrado en reposo y fail-safe.",
    "title": "SaMD Starter Kit — esqueleto de ejemplo",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/demo/internal-error": {
      "get": {
        "description": "Ilustra el handler global: un error inesperado NO filtra traceback al usuario.",
        "operationId": "demo_internal_error_demo_internal_error_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Demo Internal Error"
      }
    },
    "/demo/unavailable": {
      "get": {
        "description": "Ilustra el fusible: cuando una dependencia cae, degradamos así (no 500 seco).",
        "operationId": "demo_unavailable_demo_unavailable_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Demo Unavailable"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/notes": {
      "get": {
        "operationId": "list_notes_notes_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/NoteOut"
                  },
                  "title": "Response List Notes Notes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Falta el token o no es válido."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Notes"
      },
      "post": {
        "operationId": "create_note_notes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "El cuerpo enviado no es JSON válido."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Falta el token o no es válido."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Los datos enviados no son válidos."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Note"
      }
    }
  }
}
